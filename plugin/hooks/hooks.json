{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${CLAUDE_PLUGIN_ROOT}/../bin/roost\"; [ -x \"$r\" ] || r=roost; \"$r\" hook prompt 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${CLAUDE_PLUGIN_ROOT}/../bin/roost\"; [ -x \"$r\" ] || r=roost; \"$r\" hook stop 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
